{
  "name": "geforce-now-launcher",
  "version": "1.0.0",
  "description": "Desktop launcher for NVIDIA GeForce NOW",
  "main": "main.js",
"scripts": {
  "start": "electron .",
  "dist": "electron-builder --win nsis --publish never"
},
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.cloudgaming.geforcenowlauncher",
    "productName": "GeForce NOW Launcher",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
